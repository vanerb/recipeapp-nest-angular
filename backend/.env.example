# Sin DB_HOST la API usa un fichero SQLite en data/recipes.sqlite, sin instalar nada.
# Rellena estas variables para usar MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=recipes

# Fuerza el motor aunque DB_HOST esté definido: mysql | sqljs
# DB_TYPE=sqljs

# Obligatorio con NODE_ENV=production
JWT_SECRET=cambia-este-valor

PORT=3002
CORS_ORIGIN=http://localhost:4200
