{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "backend"
      ],
      "env": {
        "DB_TYPE": "sqljs"
      },
      "port": 3002
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "frontend"
      ],
      "port": 4200
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:demo",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "4300"
      ],
      "port": 4300
    }
  ]
}
